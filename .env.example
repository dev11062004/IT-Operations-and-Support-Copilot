# ==============================================================================
# MCP RAG Agent - Environment Configuration
# ==============================================================================

# Service Ports (Configurable for local and container deployment)
API_PORT=8000
FRONTEND_PORT=3000
MCP_SERVER_PORT=8001
MONGODB_PORT=27017

# MongoDB Configuration
# For local Docker Compose, defaults to internal service mongodb:27017
# For external MongoDB Atlas, set your cluster URI
MONGODB_ATLAS_CLUSTER_URI=mongodb://mongodb:27017
MONGODB_ATLAS_DB_NAME=mcp_rag_agent_db
MONGODB_TICKETS_COLLECTION=it_tickets
MONGODB_INCIDENTS_COLLECTION=it_incidents

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
TEXT_MODEL_NAME=gpt-4.1
EMBEDDING_MODEL_NAME=text-embedding-3-small

# LangSmith Observability & Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=mcp-rag-agent
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# Feature Flags
FEATURE_FLAG_MCPSERVER_ENABLED=false
FEATURE_FLAG_WEBSEARCH_ENABLED=false
FEATURE_FLAG_SESSION_MEMORY_ENABLED=true
FEATURE_FLAG_GUARDRAILS_ENABLED=true
FEATURE_FLAG_IT_SUPPORT_ENABLED=false

# Persistent Session Memory
MONGODB_CHECKPOINTS_COLLECTION=checkpoints
MONGODB_CHECKPOINT_WRITES_COLLECTION=checkpoint_writes
SESSION_MEMORY_TTL_SECONDS=2592000

# Standalone MCP Server Settings (FastMCP SSE)
MCP_SERVER_NAME=mongodb-semantic-search
MCP_SERVER_HOST=mcp-server
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://mcp-server:8001/sse

# RAG Safety & Grounding Guardrails
GUARDRAIL_CONFIDENCE_THRESHOLD=0.015
GUARDRAIL_MIN_VECTOR_SIMILARITY=0.50
GUARDRAIL_MAX_CONTEXT_CHARS=4000
GUARDRAIL_MIN_GROUNDING_SCORE=0.20

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
REINDEX=false

# Retrieval Settings
RETRIEVAL_OVERSAMPLE_FACTOR=3
RETRIEVAL_RRF_K=60
RETRIEVAL_DEBUG_MODE=false
RETRIEVAL_RERANKER_TYPE=none
RETRIEVAL_TOP_K=3

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
DEBUG=false
